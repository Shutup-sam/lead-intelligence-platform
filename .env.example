# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lead_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_intelligence

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Crawler Configuration (Milestone 2)
CRAWLER_REQUEST_TIMEOUT=15
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_MAX_PAGES=6
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_RETRIES=2
CRAWLER_USER_AGENT=LeadIntelligenceBot/1.0 (+https://leadintel.platform/bot)

# AI / LLM Qualification (Milestone 3)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MOCK_MODE=true
LLM_MAX_INPUT_CHARS=16000
LLM_MAX_OUTPUT_TOKENS=2000

# Embeddings & pgvector (Milestone 3)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MOCK_MODE=true

# Auth & Multi-Tenancy (Milestone 6)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ARQ Background Workers (Milestone 5)
ARQ_QUEUE_NAME=arq:queue
ARQ_MAX_TRIES=3

